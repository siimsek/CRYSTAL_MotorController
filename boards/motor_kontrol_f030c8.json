{
  "build": {
    "core": "stm32",
    "cpu": "cortex-m0",
    "extra_flags": "-DSTM32F030x8 -DSTM32F0",
    "f_cpu": "48000000L",
    "mcu": "stm32f030c8t6",
    "product_line": "STM32F030x8"
  },
  "debug": {
    "default_tools": ["stlink"],
    "jlink_device": "STM32F030C8",
    "openocd_target": "stm32f0x",
    "svd_path": "STM32F0x0.svd"
  },
  "frameworks": ["stm32cube"],
  "name": "MotorKontrol STM32F030C8T6",
  "upload": {
    "maximum_ram_size": 8192,
    "maximum_size": 65536,
    "protocol": "stlink",
    "protocols": ["stlink", "jlink"]
  },
  "url": "https://www.st.com/en/microcontrollers-microprocessors/stm32f030c8.html",
  "vendor": "Custom"
}
